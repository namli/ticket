#!/usr/bin/env python3
# tk-plugin: Local kanban board over several tk projects
# tk-plugin-version: 1.0.0
"""tk web - local kanban board over the tk projects listed in a config file.

Usage: tk web [--port N] [--config PATH]
Design: docs/superpowers/specs/2026-11-19-ticket-web-design.md
"""

import argparse
import html
import os
import re
import signal
import subprocess
import sys
import threading
import tomllib
import zlib
from dataclasses import dataclass, field
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path
from urllib.parse import parse_qs, unquote, urlsplit

DEFAULT_PORT = 7420
DEFAULT_CONFIG = '~/.config/ticket/web.toml'

EXAMPLE_CONFIG = '''\
port = 7420

[[project]]
name = "ticket"
path = "~/www/ticket"

[[project]]
name = "eagle"
path = "/home/me/www/eagle"
color = "#3b82f6"
'''

BOARD_CLOSED_LIMIT = 5
PROJECT_CLOSED_LIMIT = 50

COLUMNS = [('blocked', 'Blocked'), ('ready', 'Ready'),
           ('in_progress', 'In progress'), ('closed', 'Closed')]


# ============================================================================
# Config
# ============================================================================

class ConfigError(Exception):
    pass


@dataclass
class Project:
    name: str
    path: Path
    color: str


@dataclass
class Config:
    port: int | None
    projects: list[Project]


def load_config(path: Path) -> Config:
    try:
        with open(path, 'rb') as handle:
            data = tomllib.load(handle)
    except FileNotFoundError:
        raise ConfigError(f'config file not found: {path}') from None
    except (OSError, tomllib.TOMLDecodeError) as exc:
        raise ConfigError(f'cannot read config {path}: {exc}') from None

    port = data.get('port')
    if port is not None and (not isinstance(port, int) or isinstance(port, bool)
                             or not 0 <= port <= 65535):
        raise ConfigError(f'{path}: port must be a number from 0 to 65535, got {port!r}')

    entries = data.get('project')
    if not isinstance(entries, list) or not entries:
        raise ConfigError(f'{path}: no [[project]] entry')

    projects = []
    seen = set()
    for entry in entries:
        name = entry.get('name') if isinstance(entry, dict) else None
        if not isinstance(name, str) or not re.fullmatch(r'[A-Za-z0-9_-]+', name):
            raise ConfigError(f'{path}: project name {name!r} must match [A-Za-z0-9_-]+')
        if name in seen:
            raise ConfigError(f'{path}: project name {name!r} is used twice')
        seen.add(name)
        raw_path = entry.get('path')
        if not isinstance(raw_path, str) or not raw_path:
            raise ConfigError(f'{path}: project {name!r} has no path')
        color = entry.get('color')
        if color is None:
            color = f'hsl({zlib.crc32(name.encode()) % 360}, 55%, 45%)'
        elif not isinstance(color, str) or not re.fullmatch(r'[#A-Za-z0-9(),.% -]+', color):
            raise ConfigError(f'{path}: project {name!r} has an invalid color {color!r}')
        projects.append(Project(name, Path(raw_path).expanduser(), color))
    return Config(port, projects)


# ============================================================================
# Tickets
# ============================================================================

NOTE_STAMP = re.compile(r'^\*\*(\d{4}-\d{2}-\d{2}T[\d:]+Z)\*\*$', re.MULTILINE)
KNOWN_STATUSES = {'open', 'in_progress', 'closed', 'done'}


@dataclass
class Ticket:
    id: str
    file: str
    parsed: bool = False
    status: str = ''
    type: str = 'task'
    priority: int = 2
    assignee: str = ''
    created: str = ''
    parent: str = ''
    deps: list[str] = field(default_factory=list)
    links: list[str] = field(default_factory=list)
    tags: list[str] = field(default_factory=list)
    title: str = ''
    description: str = ''
    design: str = ''
    acceptance: str = ''
    others: list[tuple[str, str]] = field(default_factory=list)
    notes: str = ''
    last_note: str = ''


def yaml_list(value: str) -> list[str]:
    return [item.strip() for item in value.strip().strip('[]').split(',') if item.strip()]


def trim_blank(lines: list[str]) -> str:
    """Join lines without the leading and trailing blank ones."""
    start, end = 0, len(lines)
    while start < end and not lines[start].strip():
        start += 1
    while end > start and not lines[end - 1].strip():
        end -= 1
    return '\n'.join(lines[start:end])


def split_file(text: str):
    """Return (front_lines, title_index, chunks) or None when the layout is not a ticket.

    All indexes refer to text.split('\\n'). chunks is a list of (heading, start, end):
    heading is '' for the description, otherwise the text after '## '; start is the first
    line of the chunk (the heading line itself for a section), end is exclusive.
    """
    lines = text.split('\n')
    if not lines or lines[0] != '---':
        return None
    try:
        close = lines.index('---', 1)
    except ValueError:
        return None
    title_index = next((i for i in range(close + 1, len(lines)) if lines[i].startswith('# ')), None)
    if title_index is None:
        return None
    starts = [i for i in range(title_index + 1, len(lines)) if lines[i].startswith('## ')]
    bounds = [title_index + 1] + starts + [len(lines)]
    chunks = []
    for n in range(len(bounds) - 1):
        heading = '' if n == 0 else lines[bounds[n]][3:].strip()
        chunks.append((heading, bounds[n], bounds[n + 1]))
    return lines[1:close], title_index, chunks


def parse_ticket(text: str, filename: str) -> Ticket:
    ticket = Ticket(id=filename.removesuffix('.md'), file=filename)
    parts = split_file(text)
    if parts is None:
        return ticket
    front, title_index, chunks = parts
    lines = text.split('\n')
    fields = {}
    for line in front:
        key, sep, value = line.partition(':')
        if sep:
            fields[key.strip()] = value.strip()
    if not fields.get('id'):
        return ticket
    ticket.id = fields['id']
    ticket.parsed = True
    ticket.status = fields.get('status', '')
    ticket.type = fields.get('type') or 'task'
    try:
        ticket.priority = int(fields.get('priority', '2'))
    except ValueError:
        ticket.priority = 2
    ticket.assignee = fields.get('assignee', '')
    ticket.created = fields.get('created', '')
    ticket.parent = fields.get('parent', '')
    ticket.deps = yaml_list(fields.get('deps', ''))
    ticket.links = yaml_list(fields.get('links', ''))
    ticket.tags = yaml_list(fields.get('tags', ''))
    ticket.title = lines[title_index][2:].strip()
    for heading, start, end in chunks:
        if heading == '':
            ticket.description = trim_blank(lines[start:end])
            continue
        body = trim_blank(lines[start + 1:end])
        if heading == 'Design':
            ticket.design = body
        elif heading == 'Acceptance Criteria':
            ticket.acceptance = body
        elif heading == 'Notes':
            ticket.notes = body
        else:
            ticket.others.append((heading, body))
    stamps = NOTE_STAMP.findall(ticket.notes)
    ticket.last_note = stamps[-1] if stamps else ''
    return ticket


def read_ticket(path: Path) -> Ticket:
    try:
        text = path.read_text(encoding='utf-8')
    except (UnicodeDecodeError, OSError):
        return Ticket(id=path.name.removesuffix('.md'), file=path.name)
    return parse_ticket(text, path.name)


def column_of(ticket: Ticket, blocked: set[str]) -> str:
    if ticket.status in ('closed', 'done'):
        return 'closed'
    if ticket.status == 'in_progress':
        return 'in_progress'
    return 'blocked' if ticket.id in blocked else 'ready'


# ============================================================================
# Snapshots
# ============================================================================

MISSING_STAMP = frozenset({('<missing>', 0, 0)})


@dataclass
class Snapshot:
    tickets: dict[str, Ticket]
    blocked: set[str]
    error: str
    stamp: frozenset


def tickets_dir(project: Project) -> Path:
    return project.path / '.tickets'


def run_tk(project: Project, *args: str) -> subprocess.CompletedProcess:
    """Run tk for one project. Never through a shell; TICKETS_DIR is set explicitly."""
    program = os.environ.get('TK_SCRIPT') or 'tk'
    env = dict(os.environ, TICKETS_DIR=str(tickets_dir(project)))
    try:
        return subprocess.run([program, *args], cwd=project.path, env=env, text=True,
                              capture_output=True, stdin=subprocess.DEVNULL, timeout=30)
    except (OSError, subprocess.TimeoutExpired) as exc:
        return subprocess.CompletedProcess([program, *args], 127, '', str(exc))


def dir_stamp(project: Project) -> frozenset:
    try:
        entries = []
        with os.scandir(tickets_dir(project)) as scan:
            for entry in scan:
                if entry.name.endswith('.md') and not entry.name.startswith('.'):
                    info = entry.stat()
                    entries.append((entry.name, info.st_mtime_ns, info.st_size))
        return frozenset(entries)
    except OSError:
        return MISSING_STAMP


def build_snapshot(project: Project, stamp: frozenset) -> Snapshot:
    if stamp == MISSING_STAMP:
        return Snapshot({}, set(), f'{tickets_dir(project)} not found', stamp)
    tickets = {}
    for name in sorted(entry[0] for entry in stamp):
        ticket = read_ticket(tickets_dir(project) / name)
        key = ticket.id if ticket.parsed and ticket.id not in tickets else f'{name}#file'
        tickets[key] = ticket
    blocked, error = set(), ''
    if stamp:       # tk blocked exits 2 with empty stderr on a directory without tickets
        result = run_tk(project, 'blocked')
        if result.returncode != 0:
            error = f'tk blocked failed (exit {result.returncode}): {result.stderr.strip()}'
        else:
            blocked = {line.split()[0] for line in result.stdout.splitlines() if line.strip()}
    return Snapshot(tickets, blocked, error, stamp)


class Store:
    """One snapshot per project, rebuilt when the files on disk differ from its stamp."""

    def __init__(self, projects: list[Project]):
        self.projects = {p.name: p for p in projects}
        self.snapshots: dict[str, Snapshot] = {}
        self.read_locks = {p.name: threading.Lock() for p in projects}
        self.write_locks = {p.name: threading.Lock() for p in projects}

    def refresh(self, name: str) -> bool:
        project = self.projects[name]
        with self.read_locks[name]:
            stamp = dir_stamp(project)
            current = self.snapshots.get(name)
            if current is not None and current.stamp == stamp:
                return False
            self.snapshots[name] = build_snapshot(project, stamp)
            return True

    def get(self, name: str) -> Snapshot:
        self.refresh(name)
        return self.snapshots[name]

    def lock(self, name: str) -> threading.Lock:
        return self.write_locks[name]


# ============================================================================
# HTML
# ============================================================================

def esc(value) -> str:
    return html.escape(str(value), quote=True)


def page(app, title: str, main_html: str) -> str:
    nav = ['<a href="/">Lanes</a>', '<a href="/?flat=1">Flat</a>']
    nav += [f'<a href="/p/{esc(p.name)}">{esc(p.name)}</a>' for p in app.config.projects]
    return (
        '<!doctype html>\n<html lang="en">\n<head>\n<meta charset="utf-8">\n'
        f'<title>{esc(title)} - tk web</title>\n'
        '</head>\n<body>\n'
        f'<header><nav>{" ".join(nav)}</nav>'
        '<input id="q" type="search" placeholder="Search" autocomplete="off"></header>\n'
        f'<main>\n{main_html}\n</main>\n'
        '</body>\n</html>\n'
    )


def sorted_columns(snapshot: Snapshot) -> dict[str, list[Ticket]]:
    """Tickets of one project per column, in display order."""
    columns = {key: [] for key, _ in COLUMNS}
    for ticket in snapshot.tickets.values():
        if ticket.parsed:
            columns[column_of(ticket, snapshot.blocked)].append(ticket)
    for key in ('blocked', 'ready', 'in_progress'):
        columns[key].sort(key=lambda t: (t.priority, t.id))
    columns['closed'].sort(key=lambda t: t.id)
    columns['closed'].sort(key=lambda t: t.last_note or t.created, reverse=True)
    return columns


def open_blockers(ticket: Ticket, snapshot: Snapshot) -> list[str]:
    result = []
    for dep in ticket.deps:
        other = snapshot.tickets.get(dep)
        if other is None or column_of(other, snapshot.blocked) != 'closed':
            result.append(dep)
    return result


def render_card(project: Project, ticket: Ticket, snapshot: Snapshot, show_project: bool) -> str:
    classes = 'card'
    if ticket.status == 'in_progress' and ticket.id in snapshot.blocked:
        classes += ' is-blocked'
    search = ' '.join([project.name, ticket.id, ticket.title, *ticket.tags]).lower()
    parts = [f'<span class="id">{esc(ticket.id)}</span>',
             f'<span class="pri p{ticket.priority}">P{ticket.priority}</span>',
             f'<span class="type">{esc(ticket.type)}</span>']
    if ticket.status not in KNOWN_STATUSES:
        parts.append(f'<span class="status">{esc(ticket.status or "no status")}</span>')
    if show_project:
        parts.append(f'<span class="proj">{esc(project.name)}</span>')
    parts.append(f'<span class="title">{esc(ticket.title)}</span>')
    if ticket.tags:
        tags = ''.join(f'<span class="tag">{esc(tag)}</span>' for tag in ticket.tags)
        parts.append(f'<span class="tags">{tags}</span>')
    blockers = open_blockers(ticket, snapshot)
    if blockers:
        parts.append(f'<span class="blockers" title="open blockers">&#9940; {esc(" ".join(blockers))}</span>')
    if ticket.parent:
        parts.append(f'<span class="parent" title="parent">&#8593; {esc(ticket.parent)}</span>')
    return (f'<a class="{classes}" data-project="{esc(project.name)}" data-id="{esc(ticket.id)}" '
            f'data-search="{esc(search)}" href="/p/{esc(project.name)}/{esc(ticket.id)}" '
            f'style="--pc: {esc(project.color)}">{" ".join(parts)}</a>')


def render_unparsable(snapshot: Snapshot) -> str:
    return ''.join(f'<div class="card unparsable">{esc(t.file)} unparsable</div>'
                   for t in snapshot.tickets.values() if not t.parsed)


def render_column(key: str, title: str, cards_html: str, count: int) -> str:
    return (f'<section class="col" data-col="{key}"><h2>{title} <span class="n">{count}</span></h2>'
            f'{cards_html}</section>')


def render_lane(app, project: Project, closed_limit: int | None, more_href: str) -> str:
    snapshot = app.store.get(project.name)
    columns = sorted_columns(snapshot)
    open_count = sum(len(columns[key]) for key in ('blocked', 'ready', 'in_progress'))
    out = [f'<div class="lane" data-project="{esc(project.name)}" style="--pc: {esc(project.color)}">',
           f'<div class="lane-head"><a href="/p/{esc(project.name)}">{esc(project.name)}</a>'
           f'<span class="count">{open_count} open</span></div>']
    if snapshot.error:
        out.append(f'<div class="lane-error">{esc(snapshot.error)}</div>')
    for key, title in COLUMNS:
        tickets = columns[key]
        shown = tickets
        if key == 'closed' and closed_limit is not None:
            shown = tickets[:closed_limit]
        cards = ''.join(render_card(project, t, snapshot, False) for t in shown)
        if key == 'ready':
            cards += render_unparsable(snapshot)
        if len(shown) < len(tickets):
            cards += f'<a class="more" href="{esc(more_href)}">{len(tickets) - len(shown)} more</a>'
        out.append(render_column(key, title, cards, len(tickets)))
    out.append('</div>')
    return '\n'.join(out)


def render_board(app) -> str:
    return '\n'.join(render_lane(app, p, BOARD_CLOSED_LIMIT, f'/p/{p.name}')
                     for p in app.config.projects)


def render_flat(app) -> str:
    merged = {key: [] for key, _ in COLUMNS}
    totals = {key: 0 for key, _ in COLUMNS}
    extra = {key: '' for key, _ in COLUMNS}
    errors = []
    for project in app.config.projects:
        snapshot = app.store.get(project.name)
        if snapshot.error:
            errors.append(f'<div class="lane-error">{esc(project.name)}: {esc(snapshot.error)}</div>')
        columns = sorted_columns(snapshot)
        for key, _ in COLUMNS:
            tickets = columns[key]
            totals[key] += len(tickets)
            shown = tickets[:BOARD_CLOSED_LIMIT] if key == 'closed' else tickets
            merged[key] += [(project, snapshot, t) for t in shown]
            if len(shown) < len(tickets):
                extra[key] += (f'<a class="more" href="/p/{esc(project.name)}">'
                               f'{esc(project.name)}: {len(tickets) - len(shown)} more</a>')
        extra['ready'] += render_unparsable(snapshot)
    for key in ('blocked', 'ready', 'in_progress'):
        merged[key].sort(key=lambda item: (item[2].priority, item[2].id))
    merged['closed'].sort(key=lambda item: item[2].id)
    merged['closed'].sort(key=lambda item: item[2].last_note or item[2].created, reverse=True)
    out = errors + ['<div class="flat">']
    for key, title in COLUMNS:
        cards = ''.join(render_card(project, t, snapshot, True) for project, snapshot, t in merged[key])
        out.append(render_column(key, title, cards + extra[key], totals[key]))
    out.append('</div>')
    return '\n'.join(out)


def render_relation(project: Project, snapshot: Snapshot, rel: str, title: str, ids: list[str]) -> str:
    if not ids:
        return ''
    items = []
    for ticket_id in ids:
        other = snapshot.tickets.get(ticket_id)
        if other is None or not other.parsed:
            items.append(f'<li data-id="{esc(ticket_id)}">{esc(ticket_id)} '
                         '<span class="status">missing</span></li>')
        else:
            items.append(f'<li data-id="{esc(ticket_id)}">'
                         f'<a href="/p/{esc(project.name)}/{esc(ticket_id)}">{esc(ticket_id)}</a> '
                         f'{esc(other.title)} <span class="status">{esc(other.status)}</span></li>')
    return f'<div class="rel"><h3>{title}</h3><ul data-rel="{rel}">{"".join(items)}</ul></div>'


def render_text(section: str, title: str, text: str) -> str:
    if not text:
        return ''
    heading = f'<h3>{esc(title)}</h3>' if title else ''
    return f'{heading}<pre data-section="{section}">{esc(text)}</pre>'


def render_ticket(app, project: Project, snapshot: Snapshot, ticket: Ticket) -> str:
    parsed = sorted((t for t in snapshot.tickets.values() if t.parsed), key=lambda t: t.id)
    children = [t.id for t in parsed if t.parent == ticket.id]
    dependents = [t.id for t in parsed if ticket.id in t.deps]
    base = f'/p/{esc(project.name)}/{esc(ticket.id)}'
    meta = [('Status', ticket.status), ('Type', ticket.type), ('Priority', f'P{ticket.priority}'),
            ('Assignee', ticket.assignee), ('Tags', ', '.join(ticket.tags)), ('Created', ticket.created)]
    meta_html = ''.join(f'<dt>{esc(key)}</dt><dd>{esc(value)}</dd>' for key, value in meta if value)
    out = [
        f'<article class="ticket" style="--pc: {esc(project.color)}">',
        f'<p class="crumb"><a href="/p/{esc(project.name)}">{esc(project.name)}</a> / {esc(ticket.id)}</p>',
        f'<h1>{esc(ticket.title)}</h1>',
        f'<p><a class="edit" href="{base}/edit">Edit</a></p>',
        f'<dl class="meta">{meta_html}</dl>',
        render_relation(project, snapshot, 'parent', 'Parent', [ticket.parent] if ticket.parent else []),
        render_relation(project, snapshot, 'children', 'Children', children),
        render_relation(project, snapshot, 'deps', 'Depends on', ticket.deps),
        render_relation(project, snapshot, 'dependents', 'Blocks', dependents),
        render_relation(project, snapshot, 'links', 'Links', ticket.links),
        render_text('description', '', ticket.description),
        render_text('design', 'Design', ticket.design),
        render_text('acceptance', 'Acceptance Criteria', ticket.acceptance),
    ]
    out += [render_text('other', heading, text) for heading, text in ticket.others]
    out.append(render_text('notes', 'Notes', ticket.notes))
    out.append('</article>')
    return '\n'.join(part for part in out if part)


def render_project(app, project: Project, show_all: bool) -> str:
    limit = None if show_all else PROJECT_CLOSED_LIMIT
    return render_lane(app, project, limit, f'/p/{project.name}?closed=all')


# ============================================================================
# HTTP
# ============================================================================

class App:
    def __init__(self, config: Config):
        self.config = config
        self.store = Store(config.projects)
        self.port = 0

    def project(self, name: str) -> Project | None:
        for project in self.config.projects:
            if project.name == name:
                return project
        return None

    def ticket(self, name: str, ticket_id: str):
        """Return (project, snapshot, ticket) for a parsed ticket, else None.

        The id is only ever used as a dictionary key, never as part of a file path.
        """
        project = self.project(name)
        if project is None:
            return None
        snapshot = self.store.get(name)
        ticket = snapshot.tickets.get(ticket_id)
        if ticket is None or not ticket.parsed:
            return None
        return project, snapshot, ticket


class Handler(BaseHTTPRequestHandler):
    app: App = None
    server_version = 'tk-web'

    def log_message(self, format, *args):
        pass

    def send_html(self, status: int, body: str, headers: dict | None = None):
        data = body.encode('utf-8')
        self.send_response(status)
        self.send_header('Content-Type', 'text/html; charset=utf-8')
        self.send_header('Content-Length', str(len(data)))
        self.send_header('Cache-Control', 'no-store')
        for key, value in (headers or {}).items():
            self.send_header(key, value)
        self.end_headers()
        self.wfile.write(data)

    def send_error_page(self, status: int, message: str):
        self.send_html(status, page(self.app, str(status), f'<p class="msg">{esc(message)}</p>'))

    def host_allowed(self) -> bool:
        allowed = {f'127.0.0.1:{self.app.port}', f'localhost:{self.app.port}'}
        return self.headers.get('Host', '') in allowed

    def dispatch(self, method: str):
        try:
            if not self.host_allowed():
                self.send_error_page(403, 'Forbidden: unexpected Host header')
                return
            url = urlsplit(self.path)
            query = parse_qs(url.query, keep_blank_values=True)
            self.route(method, url.path, query)
        except (BrokenPipeError, ConnectionResetError):
            pass
        except Exception as exc:    # keep the server alive, show the cause
            try:
                self.send_error_page(500, f'{type(exc).__name__}: {exc}')
            except OSError:
                pass

    def route(self, method: str, path: str, query: dict):
        app = self.app
        if method == 'GET' and path == '/':
            flat = query.get('flat', [''])[0] not in ('', '0')
            self.send_html(200, page(app, 'Board', render_flat(app) if flat else render_board(app)))
            return
        match = re.fullmatch(r'/p/([A-Za-z0-9_-]+)', path)
        project = app.project(match.group(1)) if match else None
        if method == 'GET' and project is not None:
            show_all = query.get('closed', [''])[0] == 'all'
            self.send_html(200, page(app, project.name, render_project(app, project, show_all)))
            return
        match = re.fullmatch(r'/p/([A-Za-z0-9_-]+)/([^/]+)', path)
        found = app.ticket(match.group(1), unquote(match.group(2))) if match else None
        if method == 'GET' and found is not None:
            project, snapshot, ticket = found
            self.send_html(200, page(app, f'{ticket.id} {ticket.title}',
                                     render_ticket(app, project, snapshot, ticket)))
            return
        self.send_error_page(404, 'Not found')

    def do_GET(self):
        self.dispatch('GET')

    def do_POST(self):
        self.dispatch('POST')


